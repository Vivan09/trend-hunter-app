&btag=e00070000"}, "media_url": "", "text": "", "text_source": "none", "provider": "apify", "region": "GLOBAL", "region_source": "", "captured_at": "2026-10-13T01:02:38+00:00", "cluster": "", "trend_slug": "tom"}], "mentions": [{"ts": "2026-10-10T14:54:08.930+00:00", "run": "145408", "source": "tiktok", "region": "GLOBAL", "item_id": "7427927702159527198", "raw": "Tom", "url": "https://www.tiktok.com/@lackadaiisical/video/7427927702159527198", "title": "Trying out a fun character trend i’ve seen on my FYP recently !! Am I late again?? Probably. Do I care ⁉️ no not really 🗣️\n\nTHIS WAS SUPER FUN!!! It took me a few days but I’m super happy with the results :]\n\n———-\n\nOne thing I will say is that like 80% of these designs are MMMMOSTLY interpretive . You can probably tell that like. Um. Chica and springtrap. DO NOT. Actually look like that . \n\nc! Tommy was fun in the sense that I knew I had to make his character still look recognizeable while also giving him his own flair that was given to him by the fans at the time :] I DO have my own unique c! Tommy design but i decided not to use it here simply because I wasn’t sure if anyone would recognize that it IS in fact c! Tommy without putting text up there indicating that fact LOL\n(I’m not in the fandom anymore but maybe i’ll show my own designs off soon !!)\n\nAs for Nicholas, I’m pretty sure we only see his in-game avatar once or twice in the series (correct me if I’m wrong) and I didn’t want to scour through the episodes just to try and find it !! I kind of definitely totally winged this but i DISTINCTLY remember his nose being a triangle and his skin being a darkish green !! His eyes are basically just dots but I was lowkey inspired by the old PBS kids mascots so I decided to go ahead and do something fun with it instead while the idea was fresh on my mind :] \n\nALL IN ALL. A lot of this was interpretive, if you have NO IDEA who these characters are scroll and you’ll see the names, I AM SILLY THIS IS SILLY GOODBYE \n\n#a#artm#myartm#myartworka#artistsoftiktokd#digitalartd#digitalartista#arttrendsf#fanart#b#bluelockf#fnaffanartf#fnafd#danganronpam#mcyt", "description": "Trying out a fun character trend i’ve seen on my FYP recently !! Am I late again?? Probably. Do I care ⁉️ no not really 🗣️\n\nTHIS WAS SUPER FUN!!! It took me a few days but I’m super happy with the results :]\n\n———-\n\nOne thing I will say is that like 80% of these designs are MMMMOSTLY interpretive . You can probably tell that like. Um. Chica and springtrap. DO NOT. Actually look like that . \n\nc! Tommy was fun in the sense that I knew I had to make his character still look recognizeable while also giving him his own flair that was given to him by the fans at the time :] I DO have my own unique c! Tommy design but i decided not to use it here simply because I wasn’t sure if anyone would recognize that it IS in fact c! Tommy without putting text up there indicating that fact LOL\n(I’m not in the fandom anymore but maybe i’ll show my own designs off soon !!)\n\nAs for Nicholas, I’m pretty sure we only see his in-game avatar once or twice in the series (correct me if I’m wrong) and I didn’t want to scour through the episodes just to try and find it !! I kind of definitely totally winged this but i DISTINCTLY remember his nose being a triangle and his skin being a darkish green !! His eyes are basically just dots but I was lowkey inspired by the old PBS kids mascots so I decided to go ahead and do something fun with it instead while the idea was fresh on my mind :] \n\nALL IN ALL. A lot of this was interpretive, if you have NO IDEA who these characters are scroll and you’ll see the names, I AM SILLY THIS IS SILLY GOODBYE \n\n#a#artm#myartm#myartworka#artistsoftiktokd#digitalartd#digitalartista#arttrendsf#fanart#b#bluelockf#fnaffanartf#fnafd#danganronpam#mcyt", "hashtags": ["#art", "#myart", "#myartwork", "#artistsoftiktok", "#digitalart", "#digitalartist", "#arttrends", "#fanart", "#bluelock", "#fnaffanart", "#fnaf", "#danganronpa", "#mcyt"], "author": "@lackadaiisical", "views": 3139.0, "text": "", "text_source": "none"}, {"ts": "2026-10-12T18:19:34.675+00:00", "run": "181934", "source": "tiktok", "region": "GLOBAL", "item_id": "7695478178579549447", "raw": "том", "url": "https://www.tiktok.com/@vosp_ben/video/7695478178579549447", "title": "#ии #fyp ##том новый персонаж в появился новый персонаж в brawl stars срочно скачиваем последнюю версию", "description": "#ии #fyp ##том новый персонаж в появился новый персонаж в brawl stars срочно скачиваем последнюю версию", "hashtags": ["#ии", "#fyp", "#том"], "author": "@vosp_ben", "views": 422.0, "text": "", "text_source": "none"}, {"ts": "2026-10-13T01:01:57.975+00:00", "run": "010157", "source": "tiktok", "region": "GLOBAL", "item_id": "7695478178579549447", "raw": "том", "url": "https://www.tiktok.com/@vosp_ben/video/7695478178579549447", "title": "#ии #fyp ##том новый персонаж в появился новый персонаж в brawl stars срочно скачиваем последнюю версию", "description": "#ии #fyp ##том новый персонаж в появился новый персонаж в brawl stars срочно скачиваем последнюю версию", "hashtags": ["#ии", "#fyp", "#том"], "author": "@vosp_ben", "views": 424.0, "text": "", "text_source": "none"}, {"ts": "2026-10-13T01:01:57.975+00:00", "run": "010157", "source": "youtube", "region": "GLOBAL", "item_id": "i6ItqM-FTvc", "raw": "Tom", "url": "https://www.youtube.com/watch?v=i6ItqM-FTvc", "title": "Wolf Fail #shorts Collab to @TroopaDeluxe #viral #trending #mario #funny #memes", "description": "", "hashtags": ["Cartoon", "Tom Fan", "Ytshorts", "Viral Shorts", "#funny", "Cat", "Funny", "#short", "#challenge", "Meme", "#cartoon", "#animation", "Aries Fan", "Short", "Trending", "Shorts", "#cat", "Crazy Tom", "Animation", "Challenge", "Comedy", "Talking Tom", "#viral", "Cartoon Meme", "Cute", "Viral", "Cartoon Tom", "#comedy", "Wolf Fail", "#Aries Fan", "#shorts", "#TalkingTom", "#cute", "#meme", "#ytshorts", "Viral Video", "Viral Animation",