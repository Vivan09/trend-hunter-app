ные #новыйперсонаж #директор #никита #александрович #лиза #мели #лизамели #fyp #подпишись #fyppppppppppppppppppppppp #хочуврек #хочуврекомендации #минилизамели #fypppppppppppppppppppppppppppppp ", "hashtags": ["#наивные", "#новыйперсонаж", "#директор", "#никита", "#александрович", "#лиза", "#мели", "#лизамели", "#fyp", "#подпишись", "#fyppppppppppppppppppppppp", "#хочуврек", "#хочуврекомендации", "#минилизамели", "#fypppppppppppppppppppppppppppppp"], "author": "@liza_00196", "views": 327512.0, "text": "", "text_source": "none"}, {"ts": "2026-10-27T22:44:26.526+00:00", "run": "224426", "source": "tiktok", "region": "US", "item_id": "7700360495932509460", "raw": "lizok_ssk", "url": "https://www.tiktok.com/@2hlyak_/video/7700360495932509460", "title": "#golovach #dota #нарезки #lizok_ssk Дота 2 — это командная онлайн-игра, в которой две команды по пять игроков сражаются друг против друга на большой карте. Каждый игрок выбирает уникального героя со своими способностями, характеристиками и стилем игры. Главная цель — уничтожить главное здание противника, которое называется Древним. Во время матча игроки убивают крипов, сражаются с вражескими героями, зарабатывают золото и опыт, покупают предметы и постепенно усиливают своих персонажей. В игре есть разные роли: керри, мидер, оффлейнер, саппорт и полный саппорт. Керри становится сильнее к концу игры, мидер обычно получает преимущество в начале и середине матча, оффлейнер мешает противникам развиваться, а саппорты помогают команде, ставят", "description": "#golovach #dota #нарезки #lizok_ssk Дота 2 — это командная онлайн-игра, в которой две команды по пять игроков сражаются друг против друга на большой карте. Каждый игрок выбирает уникального героя со своими способностями, характеристиками и стилем игры. Главная цель — уничтожить главное здание противника, которое называется Древним. Во время матча игроки убивают крипов, сражаются с вражескими героями, зарабатывают золото и опыт, покупают предметы и постепенно усиливают сво