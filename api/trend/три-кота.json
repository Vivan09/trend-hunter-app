рек"], "author": "@lemonchik876", "views": 8709.0, "text": "", "text_source": "none"}, {"ts": "2026-09-14T15:21:49.836+00:00", "run": "152149", "source": "tiktok", "region": "RU", "item_id": "7066348529064758530", "raw": "трикота", "url": "https://www.tiktok.com/@zhopatigra2022/video/7066348529064758530", "title": "#трикота #трикотамемы #трикотартп #трикотаrytp #пуп #rytp #мем #мемы", "description": "#трикота #трикотамемы #трикотартп #трикотаrytp #пуп #rytp #мем #мемы", "hashtags": ["#трикота", "#трикотамемы", "#трикотартп", "#трикотаrytp", "#пуп", "#rytp", "#мем", "#мемы"], "author": "@zhopatigra2022", "views": 31480871.0, "text": "Три кота RYTP 😹 ВАРЕНЬЕ В ПОДВАЛЕ\nСЮРПРИЗ ДЛЯ БАБЫ КАПЫ\nВ шоколаде\nУх ты\nСейчас\nМама несет Котят в кухню, чтобы угостить папин\nМама\nА давай мы тебе поможем\nПожалуйста\nВы можете принести к чаю... моча...\nэ-э-э\nВаренье находится в шок... под...\nНу что, встали?\nТы рвет\nАй, больно\nА это что?\nНойз\nОгурец\nА перчик\nКак жжется\nВсе\nЯ устал\nЭто дно\nНо банка оказалась очень тяжелой\nНе разбилось\nТеперь надо поднять ее по ступенькам\nДарум\nА может просто съедим варенье здесь\nНу котов. Они тоже хотят варенье\nНе знаю\nПривидение\nНо оказалось, что папа слишком большой\nда", "text_source": "asr"}, {"ts": "2026-09-14T22:11:45.809+00:00", "run": "221145", "source": "tiktok", "region": "BY", "item_id": "7668964914781801749", "raw": "трикота", "url": "https://www.tiktok.com/@lemonchik876/video/7668964914781801749", "title": "я сделал Эдит с новым членом персонажем по моему этот мем очень крутой? согласен #эдит #трикота #рофл  #новыйперсонаж  #хочуврек ", "description": "я сделал Эдит с новым членом персонажем по моему этот мем очень крутой? согласен #эдит #трикота #рофл  #новыйперсонаж  #хочуврек ", "hashtags": ["#эдит", "#трикота", "#рофл", "#новыйперсонаж", "#хочуврек"], "author": "@lemonchik876", "views": 8797.0, "text": "", "text_source": "none"}, {"ts": "2026-09-15T21:49:41.609+00:00", "run": "214941", "source": "tiktok", "region": "RU", "item_id": "7066348529064758530", "raw": "Три кота", "url": "https://www.tiktok.com/@zhopatigra2022/video/7066348529064758530", "title": "#трикота #трикотамемы #трикотартп #трикотаrytp #пуп #rytp #мем #мемы", "description": "#трикота #трикотамемы #трикотартп #трикотаrytp #пуп #rytp #мем #мемы", "hashtags": ["#трикота", "#трикотамемы", "#трикотартп", "#трикотаrytp", "#пуп", "#rytp", "#мем", "#мемы"], "author": "@zhopatigra2022", "views": 31497331.0, "text": "Три кота RYTP\nВаренье в подвале\nСюрприз для бабы Капы\nпарень\nв шоколаде\nМама несетотятам кухню чтобы папин\nмама\nДавай мы тебе поможем\nпожалуйста\nВы можете принести к чаю\nмачал\nваренье находится\nв шопе \nо сколько всего интересного\nа это что\nперчик\nя устал\nэта\nНо банка оказалась очень тяжёлой\nНе разбилось\nТеперь надо поднять её по ступенькам\nа может просто съедим варенье здесь\nНу-ка кот\nони тоже хотят варенье\nНе знаю\nс привидением", "text_source": "asr"}, {"ts": "2026-09-15T21:49:41.609+00:00", "run": "214941", "source": "tiktok", "region": "US", "item_id": "7546371643925548306", "raw": "трикота", "url": "https://www.tiktok.com/@dalkrert/video/7546371643925548306", "title": "оцените ос❤️❤️❤️❤️❤️ #трикота #ос #острикота #мультик #рекомендации #оценитеос #мойновыйперсонаж #новыйперсонаж #мойос #трикота #три #кота #трикотаижертвааборта #трикотаипочемуонодосихпордышит #трикотаинежеланныйребёнок #юмор #смех #рофл #серия #смешная #киностудия #5сентября #пятоесентября ", "description": "оцените ос❤️❤️❤️❤️❤️ #трикота #ос #острикота #мультик #рекомендации #оценитеос #мойновыйперсонаж #новыйперсонаж #мойос #трикота #три #кота #трикотаижертвааборта #трикотаипочемуонодосихпордышит #трикотаинежеланныйребёнок #юмор #смех #рофл #серия #смешная #киностудия #5сентября #пятоесентября ", "hashtags": ["#трикота", "#ос", "#острикота", "#мультик", "#рекомендации", "#оценитеос", "#мойновыйперсонаж", "#новыйперсонаж", "#мойос", "#трикота", "#три", "#кота", "#трикотаижертвааборта", "#трикотаипочемуоно